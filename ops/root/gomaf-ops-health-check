#!/usr/bin/env bash
set -uo pipefail

state_dir=/var/lib/gomaf-ops-health
mkdir -p "$state_dir"
chmod 0700 "$state_dir"
DOCKER_TIMEOUT=5

failures=()
note_fail() {
  failures+=("$1")
}

if ! running_containers="$(/usr/bin/timeout "$DOCKER_TIMEOUT" /usr/bin/docker ps --format '{{.Names}}' 2>/dev/null)"; then
  running_containers=""
  note_fail "docker-control-plane-timeout"
fi

for c in gomaf-app-1 gomaf-db-1 gomaf-caddy-1; do
  if ! grep -qx "$c" <<<"$running_containers"; then
    note_fail "production-container-not-running:$c"
  fi
done

for c in gomaf-app-1 gomaf-db-1; do
  health="$(/usr/bin/timeout "$DOCKER_TIMEOUT" /usr/bin/docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$c" 2>/dev/null || true)"
  if [[ "$health" != healthy ]]; then
    note_fail "production-container-not-healthy:$c:$health"
  fi
done

for url in https://gomaf.online/ https://gomaf.online/api/v1/players; do
  code="$(/usr/bin/curl -fsS -o /dev/null -w '%{http_code}' --max-time 10 "$url" 2>/dev/null || true)"
  if [[ "$code" != 200 ]]; then
    note_fail "public-http:$url:$code"
  fi
done

for unit in gomaf-backup.timer gomaf-storage-maintenance.timer gomaf-aide-check.timer gomaf-security-check.timer; do
  if [[ "$(systemctl is-enabled "$unit" 2>/dev/null || true)" != enabled ]]; then
    note_fail "timer-not-enabled:$unit"
  fi
  if [[ "$(systemctl is-active "$unit" 2>/dev/null || true)" != active ]]; then
    note_fail "timer-not-active:$unit"
  fi
done

for unit in gomaf-backup.service gomaf-storage-maintenance.service gomaf-aide-check.service gomaf-security-check.service; do
  result="$(systemctl show "$unit" -p Result --value 2>/dev/null || true)"
  status="$(systemctl show "$unit" -p ExecMainStatus --value 2>/dev/null || true)"
  if [[ "$result" != success || "$status" != 0 ]]; then
    note_fail "scheduled-job-last-result:$unit:${result:-unknown}:${status:-unknown}"
  fi
done

for unit in gomaf-test-memory-guard.service gomaf-owner-mcp.service gomaf-owner-mcp-secret.service remote-desktop-commander.service; do
  if [[ "$(systemctl is-active "$unit" 2>/dev/null || true)" != active ]]; then
    note_fail "control-plane-not-active:$unit"
  fi
done

backup_pointer=/srv/gomaf/.deploy/last_successful_backup
if [[ ! -s "$backup_pointer" ]]; then
  note_fail "backup-pointer-missing"
else
  backup="$(cat "$backup_pointer")"
  if [[ ! -f "$backup" || ! -f "$backup.sha256" ]]; then
    note_fail "backup-artifact-or-sidecar-missing"
  else
    age=$(( $(date +%s) - $(stat -c '%Y' "$backup") ))
    if (( age > 129600 )); then
      note_fail "backup-stale-seconds:$age"
    fi
    if ! (cd "$(dirname "$backup")" && /usr/bin/sha256sum -c "$(basename "$backup").sha256" >/dev/null 2>&1); then
      note_fail "backup-checksum-failed"
    fi
  fi
fi

available_kb="$(awk '/^MemAvailable:/ {print $2; exit}' /proc/meminfo)"
swap_total_kb="$(awk '/^SwapTotal:/ {print $2; exit}' /proc/meminfo)"
swap_free_kb="$(awk '/^SwapFree:/ {print $2; exit}' /proc/meminfo)"
swap_used_kb=$((swap_total_kb - swap_free_kb))
root_free_kb="$(df -Pk / | awk 'NR==2 {print $4}')"

[[ ! -e /var/run/reboot-required ]] || note_fail "host-reboot-required"
(( available_kb >= 1048576 )) || note_fail "host-low-memory-kb:$available_kb"
(( swap_used_kb <= 524288 )) || note_fail "host-high-swap-kb:$swap_used_kb"
(( root_free_kb >= 8388608 )) || note_fail "host-low-disk-kb:$root_free_kb"

mapfile -t test_names < <(
  printf '%s\n' "$running_containers" |
  awk '/^gomaf-(stage[0-9]+|predeploy|rehearsal|deploy)-/ || /^buildx_buildkit_gomaf-(stage[0-9]+|predeploy|deploy)-/ {print}'
)
for c in "${test_names[@]}"; do
  mem="$(/usr/bin/timeout "$DOCKER_TIMEOUT" /usr/bin/docker inspect -f '{{.HostConfig.Memory}}' "$c" 2>/dev/null || echo 0)"
  cpu="$(/usr/bin/timeout "$DOCKER_TIMEOUT" /usr/bin/docker inspect -f '{{.HostConfig.NanoCpus}}' "$c" 2>/dev/null || echo 0)"
  restart="$(/usr/bin/timeout "$DOCKER_TIMEOUT" /usr/bin/docker inspect -f '{{.HostConfig.RestartPolicy.Name}}' "$c" 2>/dev/null || true)"
  if [[ ! "$mem" =~ ^[0-9]+$ ]] || (( mem <= 0 )); then
    note_fail "unbounded-test-memory:$c"
  fi
  if [[ ! "$cpu" =~ ^[0-9]+$ ]] || (( cpu <= 0 )); then
    note_fail "unbounded-test-cpu:$c"
  fi
  if [[ -n "$restart" && "$restart" != no ]]; then
    note_fail "test-restart-policy:$c:$restart"
  fi
done

ts="$(date -u +%FT%TZ)"
if (( ${#failures[@]} > 0 )); then
  {
    printf 'timestamp=%s status=FAIL\n' "$ts"
    printf 'failure=%s\n' "${failures[@]}"
  } > "$state_dir/last-health"
  cp "$state_dir/last-health" "$state_dir/last-failure"
  chmod 0600 "$state_dir/last-health" "$state_dir/last-failure"
  while IFS= read -r line; do
    /usr/bin/logger -p daemon.err -t gomaf-ops-health -- "$line"
  done < "$state_dir/last-health"
  cat "$state_dir/last-health"
  exit 1
fi

{
  printf 'timestamp=%s status=PASS\n' "$ts"
  printf 'mem_available_kb=%s swap_used_kb=%s root_free_kb=%s\n' "$available_kb" "$swap_used_kb" "$root_free_kb"
  printf 'running_bounded_test_workloads=%s\n' "${#test_names[@]}"
} > "$state_dir/last-health"
printf '%s\n' "$ts" > "$state_dir/last-success"
chmod 0600 "$state_dir/last-health" "$state_dir/last-success"
cat "$state_dir/last-health"
